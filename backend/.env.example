# Copia este archivo como .env y ajusta los valores. El .env NO se sube al repositorio.
# Base de datos: SQLite local para desarrollo o PostgreSQL creado con db/schema.sql.
#   DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/taller
DATABASE_URL=sqlite:///./taller.db

# Llave para firmar las sesiones del personal. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL pública del portal del cliente (se usa para armar el enlace seguro).
PORTAL_URL=http://localhost:8000/portal

# Contraseña de los usuarios ficticios que crea app.semilla (solo desarrollo).
SEED_PASSWORD=
